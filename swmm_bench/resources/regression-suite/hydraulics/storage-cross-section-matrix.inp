[TITLE]
Purpose-built storage and cross-section feature matrix.
Exercises all analytic storage shapes, uncommon conduit shapes, and a functional outlet.

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             02:00:00
SWEEP_START          01/01
SWEEP_END            12/31
DRY_DAYS             0
REPORT_STEP          00:05:00
WET_STEP             00:01:00
DRY_STEP             00:01:00
ROUTING_STEP         1
RULE_STEP            00:00:00
INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
VARIABLE_STEP        0.75
LENGTHENING_STEP     0
MIN_SURFAREA         12.557
MAX_TRIALS           8
HEAD_TOLERANCE       0.005
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5
MINIMUM_STEP         0.5
THREADS              1

[EVAPORATION]
CONSTANT             0.02
DRY_ONLY             NO

[JUNCTIONS]
;;Name  Elevation  MaxDepth  InitDepth  SurDepth  Aponded
J5      10         10        1          0         0

[STORAGE]
;;Name  Elevation  MaxDepth  InitDepth  Shape        Param1  Param2  Param3  SurDepth  Fevap
S1      10         5         1          CYLINDRICAL  10      10      0       0         0.5
S2      10         5         1          CONICAL      10      10      0.5     0         0.5
S3      10         5         1          PARABOLIC    10      10      5       0         0.5
S4      10         5         1          PYRAMIDAL    10      10      0.5     0         0.5
S5      10         5         1          FUNCTIONAL   20      1       20      0         0.5

[OUTFALLS]
;;Name  Elevation  Type  Stage Data  Gated
OUT1    0          FREE              NO
OUT2    0          FREE              NO
OUT3    0          FREE              NO
OUT4    0          FREE              NO
OUT5    0          FREE              NO
OUT6    0          FREE              NO

[CONDUITS]
;;Name  From Node  To Node  Length  Roughness  InOffset  OutOffset  InitFlow  MaxFlow
C1      S1         OUT1     500     0.013      0         0          0         0
C2      S2         OUT2     500     0.013      0         0          0         0
C3      S3         OUT3     500     0.013      0         0          0         0
C4      S4         OUT4     500     0.013      0         0          0         0
C5      J5         OUT5     500     0.013      0         0          0         0

[OUTLETS]
;;Name  From Node  To Node  Offset  Type              Qcoeff  Qexpon  Gated
O1      S5         OUT6     0       FUNCTIONAL/DEPTH  1.0     1.0     NO

[XSECTIONS]
;;Link  Shape       Geom1  Geom2  Geom3  Geom4  Barrels
C1      PARABOLIC   4      6      0      0      1
C2      POWER       4      6      2      0      1
C3      RECT_ROUND  4      6      3      0      1
C4      MODBASKETHANDLE  4  6      3      0      1
C5      RECT_OPEN   4      6      0      0      1

[INFLOWS]
;;Node  Constituent  Time Series  Type  Mfactor  Sfactor  Baseline
S1      FLOW         Flow         FLOW  1.0      1.0      0
S2      FLOW         Flow         FLOW  1.0      1.0      0
S3      FLOW         Flow         FLOW  1.0      1.0      0
S4      FLOW         Flow         FLOW  1.0      1.0      0
S5      FLOW         Flow         FLOW  1.0      1.0      0
J5      FLOW         Flow         FLOW  1.0      1.0      0

[TIMESERIES]
;;Name  Date  Time  Value
Flow          0:00  0
Flow          0:10  5
Flow          0:30  25
Flow          1:00  50
Flow          1:30  5
Flow          2:00  0

[REPORT]
INPUT          YES
CONTROLS       NO
SUBCATCHMENTS  NONE
NODES          ALL
LINKS          ALL
